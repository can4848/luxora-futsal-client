{
  "name": "luxora-client",
  "version": "0.1.0",
  "description": "Luxora Futsal odalarında sesli sohbet sağlayan Haxball istemcisi",
  "author": "Luxora Futsal",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "dist:mac": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.luxorafutsal.client",
    "productName": "Luxora Futsal",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "game-preload.js",
      "voice.js",
      "renderer/**/*",
      "assets/**/*"
    ],
    "asar": true,
    "compression": "maximum",
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "LuxoraFutsal-${version}-win.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.games",
      "identity": "-",
      "artifactName": "LuxoraFutsal-${version}-mac-${arch}.${ext}",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Luxora odalarında takım arkadaşlarınla sesli konuşabilmen için mikrofon gerekiyor."
      }
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Game",
      "synopsis": "Luxora Futsal masaüstü istemcisi",
      "artifactName": "LuxoraFutsal-${version}-linux-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "LuxoraFutsal-${version}.${ext}",
      "unicode": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Luxora Futsal",
      "artifactName": "LuxoraFutsal-Kurulum-${version}.${ext}",
      "language": "1055"
    }
  },
  "license": "MIT",
  "homepage": "https://luxorafutsal.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/can4848/luxora-futsal-client.git"
  }
}
